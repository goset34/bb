{
  "name": "strata",
  "version": "0.1.0",
  "private": true,
  "description": "STRATA — sandbox de vóxeles para navegador (WebGPU/WebGL2)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "shot": "node scripts/shot.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "map": "tsx scripts/worldmap.ts",
    "genview": "tsx scripts/genview.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^22.10.0",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {}
}
